import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns


df = pd.read_csv("online_retail_II.csv")


df.shape


df.head()


df.isnull().sum()


# Data  Pre processing


df = df.drop(columns=["Country", "StockCode"])


df = df.dropna(subset=['Description'])


df.shape


df['InvoiceDate'] = pd.to_datetime(df['InvoiceDate'])
latest_date = df['InvoiceDate'].max()
recency_df = df.groupby('Customer ID')['InvoiceDate'].max().reset_index()
recency_df['Recency'] = (latest_date - recency_df['InvoiceDate']).dt.days

recency_df = recency_df.drop(columns=['InvoiceDate'])


df.head()



