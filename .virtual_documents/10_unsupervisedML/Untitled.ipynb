


import seaborn as sns
from sklearn.datasets import make_blobs  #to produce data for clusters



# Generation of dummy data: 
X, y = make_blobs(
    n_samples = 1000,
    n_features = 2,
    centers = 4,
    random_state=42
)


X


y


# Visualize:

sns.scatterplot(x=X[:, 0], y=X[:, 1])





from sklearn.cluster import KMeans


K = 4

kmeans = KMeans(
    n_clusters=K,
    random_state=42
)


labels = kmeans.fit_predict(X)           #fit predict can be done combined in unsupervised learning


sns.scatterplot(x=X[:, 0], y=X[:, 1]. c=labels)



