import torch
import torch.nn as nn
import torch.optim as optiizer

import torchvision # a library which is specifically for computer vision
# it includes:
# popular datasets such as CIFAR10, MNIST
# pre trained CNNs
# Utilities for image transformation 


from torchvision.datasets import CIFAR10


# Datasets & Dataloaders:
from torch.utils.data import DataLoader
import torchvision.transforms as transforms

#image => scale (0,1) => Normalize => (-1,1)
transform = transforms.Compose([
    transforms.ToTensor(),
    transforms.Normalize((0.5, 0.5, 0.5), (0.5, 0.5, 0.5))
])

trainset = CIFAR10(root="./Data", train=True, download=True, transform= transform)
testset = CIFAR10(root="./Data", train=False, download=True, transform= transform)


trainset


trainloader = DataLoader(trainset, batch_size=64, shuffle= True)
testloader = DataLoader(testset, batch_size=64)





 class CNN(nn.Module):
     def __init__(self):
         super(CNN, self).__init__()

         self.conv_layers = nn.Sequential(
             nn.Conv2d(3, 32 , kernel_size=3, padding=1),
             nn.ReLU(),
             nn.MaxPool2d(2,2), # kernel size = 2, stride value=2

             nn.Conv2d(32, 64 , kernel_size=3, padding=1),
             nn.ReLU(),
             nn.MaxPool2d(2,2),

             nn.Conv2d(64, 128 , kernel_size=3, padding=1),
             nn.ReLU(),
             nn.MaxPool2d(2,2),
             
         )

## the input size is 32X32X3 so n=32, filter=3, stride=1, padding val=1
## to calculate output =    n-f+2p  
#                          --------  +1    = 32
#                              s
# so output will be 32X32

        self.fc_layers = nn.Sequential(
            nn.Linear(4*4*128, 256),
            nn.ReLU(),

            nn.Linear
        )

    def forward(selc, x):
        x= self.conv_layers(x)
        x= x.view(x.size(0), -1)  #flatteining
        x= self.fc_layers(x)

        return x



