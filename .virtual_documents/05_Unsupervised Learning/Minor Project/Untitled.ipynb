import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns


df = pd.read_csv("smartcart_customers.csv")


df.head()


df.shape


df.isnull().sum()








df["Income"] = df["Income"].fillna(df["Income"].median())


df.isnull().sum()





# We can convert birth year to more meaningful feature => Age
df["Age"] = 2026-df["Year_Birth"]


# Date of customer joining can be converted to Customer Tenure Days (customer ko join kiye kitne idn hogye)

df["Dt_Customer"] = pd.to_datetime(df["Dt_Customer"], dayfirst=True)

reference_date = df["Dt_Customer"].max()

df["Customer_Tenure_Days"] = (reference_date - df["Dt_Customer"]).dt.days


df.columns


#Combining spendings =>Total spending  

df["Total_Spending"] = df["MntWines"] + df["MntFruits"] + df["MntMeatProducts"] + df["MntFishProducts"] + df["MntSweetProducts"] + df["MntGoldProds"]


df["Total_Children"] = df["Kidhome"] + df["Teenhome"] 


# Education

df["Education"].value_counts()


# Converting it in  UG , Graduate and PG

df["Education"] = df["Education"].replace({
    "Basic": "Undergraduate",
    "2n Cycle": "Undergraduate",
    "Graduation": "Graduate",
    "Master": "Postgraduate",
    "PhD": "Postgraduate"
})


df["Education"].value_counts()


# Marital Status

df["Marital_Status"].value_counts()


df["Living_With"] = df["Marital_Status"].replace({
    "Married": "Partner",
    "Together": "Partner",
    "Single": "Alone",
    "Divorced": "Alone",
    "Widow": "Alone",
    "Alone": "Alone",
    "Absurd": "Alone",
    "YOLO": "Alone"
})


df["Living_With"].value_counts()





cols =  ["ID", "Year_Birth", "Marital_Status", "Kidhome", "Teenhome", "Dt_Customer", "MntWines", "MntFruits" , "MntMeatProducts", "MntFishProducts", "MntSweetProducts", "MntGoldProds"]

df_cleaned = df.drop(columns= cols)


df_cleaned.shape


df.shape





cols = ["Income", "Recency", "Response", "Age", "Total_Spending", "Total_Children"]

# Relative plots of some features - pair plots
sns.pairplot(df_cleaned[cols])





# REmove the outliers:

print(" Data size with outliers is: ", len(df_cleaned))

df_cleaned = df_cleaned[ (df_cleaned["Age"] < 90) ]
df_cleaned = df_cleaned[ (df_cleaned["Income"] < 600_000) ]

print(" Data size without outliers is: ", len(df_cleaned))





#correlation matrix
corr = df_cleaned.corr(numeric_only=True)
corr


plt.figure(figsize=(8,6))

sns.heatmap(
    corr,
    annot=True,
    annot_kws={"size" : 6},
    cmap="coolwarm"
)





#Feature Encoding

from sklearn.preprocessing import OneHotEncoder


ohe = OneHotEncoder()

cat_cols = ["Education" , "Living_With"]

enc_cols = ohe.fit_transform(df_cleaned[cat_cols])


enc_df = pd.DataFrame(enc_cols.toarray(), columns=ohe.get_feature_names_out(cat_cols), index=df_cleaned.index) 


df_encoded = pd.concat([df_cleaned.drop(columns=cat_cols) , enc_df], axis=1)


df_encoded.shape


df_encoded.head()





from sklearn.preprocessing import StandardScaler 


X = df_encoded
scaler = StandardScaler()

X_scaled = scaler.fit_transform(X)


X_scaled.shape
# there are 18 features, so we cant visualize that much features, we need to use the PCA


#Visualize

#2D 

from sklearn.decomposition import PCA


pca = PCA(n_components=2)

X_pca = pca.fit_transform(X_scaled)


#plot

plt.scatter(X_pca[:,0], X_pca[:,1])


pca = PCA(n_components=3)

X_pca = pca.fit_transform(X_scaled)

# plot (3D)
fig = plt.figure(figsize=(8, 6))

ax = fig.add_subplot(111, projection="3d")

ax.scatter(X_pca[:, 0], X_pca[:, 1], X_pca[:, 2])

ax.set_xlabel("PCA1")
ax.set_ylabel("PCA2")
ax.set_zlabel("PCA3")
ax.set_title("3d projection")



