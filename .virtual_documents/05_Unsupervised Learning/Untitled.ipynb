import seaborn as sns
from sklearn.datasets import make_blobs # dummy data to create clusters


X,y = make_blobs(
    n_samples=1000,
    n_features=2,
    centers=4,
    random_state=42
)
# here, y is containing the output labels but we use unlabeleed data in unsupervised, so , we focus only on X


# Visualize
sns.scatterplot(x=X[:, 0], y=X[: ,1])  # 0th feature of x o x axis and 1st deature of X on y axis


# Scaling is important in this because it is distance based algo
# Skipping the data here because it is pre generated


# K-means:


from sklearn.cluster import KMeans


# we already know that k=4

k=4

kmeans = KMeans(
    n_clusters=k,
    random_state=42
)


# No train test split required in unsupervised learning

# Fit and predict can be done in same step


y_pred = kmeans.fit_predict(X)  


sns.scatterplot(x=X[:, 0], y=X[: ,1], c=y_pred)



