import seaborn as sns
from sklearn.datasets import make_blobs # dummy data to create clusters


X,y = make_blobs(
    n_samples=1000,
    n_features=2,
    centers=4,
    random_state=42
)
# here, y is containing the output labels but we use unlabeleed data in unsupervised, so , we focus only on X


# Visualize
sns.scatterplot(x=X[:, 0], y=X[: ,1])  # 0th feature of x o x axis and 1st deature of X on y axis


# Scaling is important in this because it is distance based algo
# Skipping the data here because it is pre generated


# K-means:


from sklearn.cluster import KMeans


# we already know that k=4

k=4

kmeans = KMeans(
    n_clusters=k,
    random_state=42
)


# No train test split required in unsupervised learning

# Fit and predict can be done in same step


labels = kmeans.fit_predict(X)   # Labels = Cluster number


sns.scatterplot(x=X[:, 0], y=X[: ,1], c=labels)








wcss= []

for k in range(1,21):
    kmeans = KMeans(n_clusters=k)
    kmeans.fit_predict(X)
    wcss.append(kmeans.inertia_)   #(inertia_ is the parameter where value of wcss is stored)


sns.lineplot(x=range(1,21), y=wcss, marker='o')





#kneed module:
!pip install kneed


from kneed import KneeLocator


knee = KneeLocator(range(1,21), wcss, curve="convex", direction="decreasing")


print("Optimal k is : ",knee.knee)





