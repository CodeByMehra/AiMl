        "import torch\n",
        "import torch.nn as nn\n",
        "import torch.optim as optimizer\n",
        "\n",
        "import torchvision # a library which is specifically for computer vision\n",
        "# it includes:\n",
        "# popular datasets such as CIFAR10, MNIST\n",
        "# pre trained CNNs\n",
        "# Utilities for image transformation"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 2,
      "id": "5cc79fcc-7dd0-41bc-ba83-499061d56e77",
      "metadata": {
        "id": "5cc79fcc-7dd0-41bc-ba83-499061d56e77"
      },
      "outputs": [],
      "source": [
        "from torchvision.datasets import CIFAR10"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 3,
      "id": "d9b00f73-8f48-45a8-9e90-35081f32ddec",
      "metadata": {
        "id": "d9b00f73-8f48-45a8-9e90-35081f32ddec",
        "outputId": "c587572d-df71-4dab-abe3-ad162ca88618",
        "colab": {
          "base_uri": "https://localhost:8080/"
        }
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stderr",
          "text": [
            "100%|██████████| 170M/170M [00:05<00:00, 28.8MB/s]\n"
          ]
        }
      ],
      "source": [
        "# Datasets & Dataloaders:\n",
        "from torch.utils.data import DataLoader\n",
        "import torchvision.transforms as transforms\n",
        "\n",
        "#image => scale (0,1) => Normalize => (-1,1)\n",
        "transform = transforms.Compose([\n",
        "    transforms.ToTensor(),\n",
        "    transforms.Normalize((0.5, 0.5, 0.5), (0.5, 0.5, 0.5))\n",
        "])\n",
        "\n",
        "trainset = CIFAR10(root=\"./Data\", train=True, download=True, transform= transform)\n",
        "testset = CIFAR10(root=\"./Data\", train=False, download=True, transform= transform)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 4,
      "id": "4f546140-bc68-438b-8e19-9af3e977cdfe",
      "metadata": {
        "id": "4f546140-bc68-438b-8e19-9af3e977cdfe",
        "outputId": "e974ed4b-81ea-45d6-d24c-91935e28e061",
        "colab": {
          "base_uri": "https://localhost:8080/"
        }
      },
      "outputs": [
        {
          "output_type": "execute_result",
          "data": {
            "text/plain": [
              "Dataset CIFAR10\n",
              "    Number of datapoints: 50000\n",
              "    Root location: ./Data\n",
              "    Split: Train\n",
              "    StandardTransform\n",
              "Transform: Compose(\n",
              "               ToTensor()\n",
              "               Normalize(mean=(0.5, 0.5, 0.5), std=(0.5, 0.5, 0.5))\n",
              "           )"
            ]
          },
          "metadata": {},
          "execution_count": 4
        }
      ],
      "source": [
        "trainset"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 5,
      "id": "e65180ba-67ce-45fa-9256-a7fee70b9740",
      "metadata": {
        "id": "e65180ba-67ce-45fa-9256-a7fee70b9740"
      },
      "outputs": [],
      "source": [
        "trainloader = DataLoader(trainset, batch_size=64, shuffle= True)\n",
        "testloader = DataLoader(testset, batch_size=64)"
      ]
    },
    {
      "cell_type": "markdown",
      "id": "a744d762-c14f-40dd-a017-ec3c6ca4fc16",
      "metadata": {
        "id": "a744d762-c14f-40dd-a017-ec3c6ca4fc16"
      },
      "source": [
        "### Build the CNN"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 6,
      "id": "86d7d5c0-76dd-49f3-8d6c-8b1cec421dec",
      "metadata": {
        "id": "86d7d5c0-76dd-49f3-8d6c-8b1cec421dec"
      },
      "outputs": [],
      "source": [
        "import torch\n",
        "import torch.nn as nn\n",
        "\n",
        "class CNN(nn.Module):\n",
        "    def __init__(self):\n",
        "        super(CNN, self).__init__()\n",
        "\n",
        "        self.conv_layers = nn.Sequential(\n",
        "            nn.Conv2d(3, 32, kernel_size=3, padding=1),\n",
        "            nn.ReLU(),\n",
        "            nn.MaxPool2d(2, 2),\n",
        "\n",
        "            nn.Conv2d(32, 64, kernel_size=3, padding=1),\n",
        "            nn.ReLU(),\n",
        "            nn.MaxPool2d(2, 2),\n",
        "\n",
        "            nn.Conv2d(64, 128, kernel_size=3, padding=1),\n",
        "            nn.ReLU(),\n",
        "            nn.MaxPool2d(2, 2),\n",
        "        )\n",
        "\n",
        "\n",
        "## the input size is 32X32X3 so n=32, filter=3, stride=1, padding val=1\n",
        "## to calculate output =    n-f+2p\n",
        "#                          --------  +1    = 32\n",
        "#                              s\n",
        "# so output will be 32X32\n",
        "\n",
        "        self.fc_layers = nn.Sequential(\n",
        "            nn.Linear(4 * 4 * 128, 256),\n",
        "            nn.ReLU(),\n",
        "\n",
        "            nn.Linear(256, 10)   # assuming 10 output classes\n",
        "        )\n",
        "\n",
        "    def forward(self, x):   # fixed 'selc' → 'self'\n",
        "        x = self.conv_layers(x)\n",
        "        x = x.view(x.size(0), -1)   # flattening\n",
        "        x = self.fc_layers(x)\n",
        "        return x\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 7,
      "id": "1f6b9ff2-3079-49ff-987b-3fa3277f2054",
      "metadata": {
        "id": "1f6b9ff2-3079-49ff-987b-3fa3277f2054"
      },
      "outputs": [],
      "source": [
        "model = CNN()"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 8,
      "id": "319a68cc-e510-400d-8980-a679325a1eaf",
      "metadata": {
        "id": "319a68cc-e510-400d-8980-a679325a1eaf"
      },
      "outputs": [],
      "source": [
        "criterion = nn.CrossEntropyLoss()\n",
        "optimizer = optimizer.Adam(model.parameters())"
      ]
    },
    {
      "cell_type": "markdown",
      "id": "2fc5dd8a-7e4b-468f-87fb-4fb3a44498fa",
      "metadata": {
        "id": "2fc5dd8a-7e4b-468f-87fb-4fb3a44498fa"
      },
      "source": [
        "### Training the CNN:"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 9,
      "id": "30845755-d182-4c7f-a8ff-20f8ec2312b5",
      "metadata": {
        "id": "30845755-d182-4c7f-a8ff-20f8ec2312b5",
        "outputId": "dcdb3481-7844-4100-b732-48a5367fdee5",
        "colab": {
          "base_uri": "https://localhost:8080/"
        }
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "epoch=1/10 & loss = 1.327736123214902\n",
            "epoch=2/10 & loss = 0.8961382121076364\n",
            "epoch=3/10 & loss = 0.7160173345862142\n",
            "epoch=4/10 & loss = 0.5908052757039399\n",
            "epoch=5/10 & loss = 0.4832463719693901\n",
            "epoch=6/10 & loss = 0.3884967966171939\n",
            "epoch=7/10 & loss = 0.3032203806692834\n",
            "epoch=8/10 & loss = 0.2269239699291756\n",
            "epoch=9/10 & loss = 0.17457030798830186\n",
            "epoch=10/10 & loss = 0.14224284734634107\n"
          ]
        }
      ],
      "source": [
        "epochs = 10\n",
        "\n",
        "for epoch in range(epochs):\n",
        "    training_loss = 0.0\n",
        "\n",
        "    for images,labels in trainloader:\n",
        "        optimizer.zero_grad()\n",
        "\n",
        "        output= model.forward(images)\n",
        "        loss =criterion(output, labels)\n",
        "        loss.backward()\n",
        "        optimizer.step()\n",
        "\n",
        "        training_loss += loss.item()\n",
        "\n",
        "    print(f\"epoch={epoch+1}/{epochs} & loss = {training_loss/len(trainloader)}\")"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 10,
      "id": "06cbd820-974f-4c42-932e-56565414282c",
      "metadata": {
        "id": "06cbd820-974f-4c42-932e-56565414282c",
        "outputId": "60596c30-e33b-4d50-d5ab-07a7999675b3",
        "colab": {
          "base_uri": "https://localhost:8080/"
        }
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Accuracy = 76.1%\n"
          ]
        }
      ],
      "source": [
        "# Evalueating our CNN:\n",
        "\n",
        "correct_labels = 0\n",
        "total_labels = 0\n",
        "\n",
        "model.eval()\n",
        "\n",
        "with torch.no_grad():\n",
        "    for images, labels in testloader:\n",
        "        outputs = model.forward(images)\n",
        "\n",
        "        _, predicted = torch.max(outputs, 1)\n",
        "\n",
        "        correct_labels += (predicted == labels).sum().item()\n",
        "        total_labels += labels.size(0)\n",
        "\n",
        "print(f\"Accuracy = {100 * correct_labels / total_labels}%\")\n",
        "\n",
        ""
      ]
    }
